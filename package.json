{
  "name": "easyfilla",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-tesseract-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "predev": "node scripts/copy-tesseract-assets.mjs && node scripts/generate-icons.mjs",
    "prebuild": "node scripts/copy-tesseract-assets.mjs && node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "audit": "npm audit --audit-level=high",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/chrome": "^0.2.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "officeparser": "^8.0.0",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  }
}
