node_modules/
dist/
.vite/
*.local

# Tesseract worker/core/language data. NOT committed on purpose, and this does
# NOT break a fresh clone: scripts/copy-tesseract-assets.mjs runs on
# postinstall/predev/prebuild and regenerates all 6.7 MB from the declared
# tesseract.js and @tesseract.js-data/eng dependencies. Committing binaries npm
# can reproduce would only bloat the repo.
public/tesseract/

# ── Credentials ──────────────────────────────────────────────────────────
# Nothing matching these has ever existed in this repo. The rules are here so
# that an accidental future one is caught BEFORE a first commit, not after.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# esbuild bundles generated by tests/run.mjs. It deletes them on a clean exit,
# but an interrupted run (Ctrl-C, a crash) leaves them behind — and each is a
# whole-program bundle of src/, so committing one would duplicate the entire
# codebase inside a build artifact.
tests/_bundle-*.mjs
